# Gemini API key, used by the Fuel food scan and the AI Coach.
# Copy this file to .env.local and fill in your key. The app runs without it —
# those two features simply report that the link is severed.
#
# WARNING: vite inlines this into the client bundle, so it is visible to anyone
# who loads the app. Only use a key you are willing to expose, and move these
# calls behind a server route before deploying publicly.
GEMINI_API_KEY=
